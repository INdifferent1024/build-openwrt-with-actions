#
# CR8808 / Xiaomi CR880X (M79) 专用配置
# 源: kmiit/Redmi_AX3000_immortalwrt  分支 redmi_ax3000-24.10
# 架构: qualcommax / ipq50xx (aarch64_cortex-a53)
# 内核: 6.6
#

# === 目标架构 (关键, 必须精确) ===
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y
# CONFIG_TARGET_ALL_PROFILES is not set

# === 镜像 ===
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_IMAGES_GZIP=y

# === 编译优化 ===
CONFIG_DEVEL=n
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_PKG_BUILD_USE_JOBSERVER=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"

# ============================================
# UA2F 依赖链 (NFQUEUE 模式)
# ============================================
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_libuci=y

# === 内核: NFQUEUE ===
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-nat=y

# === iptables 后端 ===
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-filter=y
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nfqueue=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-filter=y

# === ip-full ===
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set

# === nftables / 防火墙 ===
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nf-tproxy=y

# === UA2F ===
CONFIG_PACKAGE_ua2f=y
CONFIG_UA2F_CUSTOM_USER_AGENT=y
CONFIG_UA2F_USER_AGENT_STRING="FFF"
CONFIG_UA2F_ENABLE_LIBBACKTRACE=n

# ============================================
# LuCI
# ============================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ============================================
# 系统基础
# ============================================
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# === WiFi 驱动 (保持默认, 不改动) ===
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018=y
CONFIG_PACKAGE_ath11k-firmware-qcn6122=y

# ============================================
# 明确排除 (避免编译失败/占空间)
# ============================================
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_ua3f is not set
